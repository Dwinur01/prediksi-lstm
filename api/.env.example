# Konfigurasi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=prediksi_lstm
DB_USER=prediksi_user
DB_PASS=rahasia_password_db

# Kunci Rahasia JWT (HS256)
JWT_SECRET=ganti_dengan_kunci_rahasia_jwt_acak_minimal_32_karakter

# CORS Whitelist (domain frontend yang diizinkan, pisahkan koma jika multi)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fallback ke SQLite jika MySQL tidak aktif: 'sqlite' untuk aktifkan, '0' untuk matikan
DB_FALLBACK=0
